---
import Image from "astro/components/Image.astro";
import { SITE_TITLE } from "../consts";
import HeaderLink from "./HeaderLink.astro";
import aba from "../assets/aba.png";
---

<header class="fixed z-10 w-full backdrop-blur-2xl py-2 px-8">
    <nav class="text-background/80 flex justify-between items-center">
        <a href=""
            ><Image
                src={aba}
                width={80}
                alt="logo academia basica del aire"
            /></a
        >
        <div class="flex flex-col gap-2">
            <div class="internal-links flex justify-end gap-4">
                <HeaderLink href="/">Inicio</HeaderLink>
                <HeaderLink href="/blog">Noticias</HeaderLink>
                <HeaderLink href="/about">Reportajes</HeaderLink>
                <HeaderLink href="/about">Entrevistas</HeaderLink>
            </div>
            <hr class="border-b border-gray-500" />
            <div class="internal-links flex gap-4 justify-start">
                <HeaderLink href="/">Deporte</HeaderLink>
                <HeaderLink href="/blog">Internacional</HeaderLink>
                <HeaderLink href="/about">Unidades</HeaderLink>
                <HeaderLink href="/about">La cantina</HeaderLink>
            </div>
        </div>
    </nav>
</header>
