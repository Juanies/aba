---
import NewspaperLayout from "../layouts/NewspaperLayout.astro";
import { getNewspapers, getNewspaperPosts } from "../data/newspapers";
import Image from "astro/components/Image.astro";

const newspapers = await Promise.all(
    getNewspapers().map(async (newspaper) => ({
        newspaper,
        posts: await getNewspaperPosts(newspaper.id),
    })),
);
---

<NewspaperLayout
    title="Periódicos digitales"
    description="Explora nuestras ediciones digitales."
>
    <header class="mx-auto flex flex-col items-center max-w-7xl">
        <h1
            class="text-8xl  max-w-[16ch] text-center font-bold
                text-transparent bg-linear-to-r
                from-primary via-white/90 to-primary
                bg-clip-text"
        >
            Academia basica del aire y del espacio
        </h1>
        <p class="text-3xl mt-12">
            Elige un periodico para descubrir sus publicaciones.
        </p>
    </header>
    <section
        class="newspapers mt-24 grid grid-cols-3 gap-12"
        aria-label="Periódicos disponibles"
    >
        {
            newspapers.map(({ newspaper }) => (
                <article class="group overflow-hidden rounded-2xl border border-white/10 bg-white/[0.06] shadow-lg shadow-black/5 transition-all duration-300 hover:-translate-y-1 hover:border-white/20 hover:bg-white/[0.09] hover:shadow-xl">
                    <a
                        href={`/periodicos/${newspaper.slug}`}
                        class="flex h-full flex-col"
                    >
                        <div class="relative aspect-[4/3] overflow-hidden bg-gray-100">
                            <Image
                                src={newspaper.cover}
                                class="h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-105"
                                height={400}
                                width={600}
                                alt={`Portada de ${newspaper.title}`}
                            />

                            <div class="absolute inset-0 bg-linear-to-t from-black/50 via-transparent to-black/10" />

                            <div class="absolute left-4 top-4">
                                <span class="inline-flex items-center rounded-full border border-white/20 bg-black/30 px-3 py-1.5 text-xs font-semibold text-white backdrop-blur-md">
                                    {newspaper.createdAt}
                                </span>
                            </div>

                            <div class="absolute bottom-4 right-4 flex h-10 w-10 items-center justify-center rounded-full border border-white/20 bg-black/30 text-white backdrop-blur-md transition-all duration-300 group-hover:translate-x-1 group-hover:bg-white group-hover:text-gray-900">
                                →
                            </div>
                        </div>

                        <div class="flex flex-1 flex-col gap-3 p-5">
                            <h2 class="text-xl font-bold tracking-tight text-white transition-colors group-hover:text-white/80">
                                {newspaper.title}
                            </h2>

                            <p class="line-clamp-2 text-sm leading-relaxed text-white/60">
                                {newspaper.description}
                            </p>

                            <div class="mt-auto pt-3">
                                <span class="text-sm font-semibold text-white/80 transition-colors group-hover:text-white">
                                    Ver periodico
                                    <span class="ml-1 inline-block transition-transform duration-300 group-hover:translate-x-1">
                                        →
                                    </span>
                                </span>
                            </div>
                        </div>
                    </a>
                </article>
            ))
        }
    </section>
</NewspaperLayout>
